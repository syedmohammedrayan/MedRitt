# MedRittAI repository allowlist/cleanup rules

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Python environments, caches, and test output
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
build/
dist/

# Frontend dependencies and generated output
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE, OS, and local agent state
.agents/
.tmp/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
tempCodeRunnerFile.py

# Runtime medical data: never commit patient uploads or the SQLite database
backend/data/
data/*
!data/.gitkeep
test_data/
*.db
*.db-journal
*.sqlite
*.sqlite3

# Keep only bundled model artifacts used by the application. RAD-DINO is fetched
# from its pinned Hugging Face revision and is not duplicated in this repository.
models/*
!models/readme.md
*.keras
*.h5
*.onnx
*.ckpt
*.safetensors
*.zip

# Local training, experiments, duplicate repositories, and prototypes
Multi-organ-diagnostic/
MedVision-AI/
brain_tumor_analysis/
brainnn/
assests/
datasets/
demo/
files/
notebooks/
presentation/
report/
tools/
docs/
*.ipynb
*.pdf

# Superseded planning/demo artifacts (not required to run a clone)
/HACKATHON_VIDEO_DEMO_GUIDE.md
/implementation_front.md
/implementation_plan.md
/implmeeeettt.md
/medritt-proto.html
/task.md
/backend/_check_layers.py
/frontend/src/assets/
/frontend/public/icons.svg

# Temporary and scratch investigation files
token.json
scratch_*.py
backend/scratch_*.py
backend/fix_db.py
backend/out.json
smoke_test.py
backend/smoke_test.py
test_db.py
backend/test_db.py

# Framework/tool state
.streamlit/
.cache/
.tox/
.nox/
.pdm-python
.pdm-build/
.pixi/
__pypackages__/

# Active Jeevansh models
!models/jeevansh/
!models/jeevansh/*
