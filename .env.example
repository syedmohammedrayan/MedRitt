# ==========================================
# MedRittAI - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values.

# --- Security ---
SECRET_KEY=

# --- Application Database (SQLite Only) ---
DATABASE_URL=sqlite:///./data/medritt.db

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ORIGIN_REGEX=

# --- Cloudinary Storage ---
CLOUDINARY_ENABLED=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=medritt

# --- Gemini Report AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Groq Scan-Type Verifier ---
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- NVIDIA Report QA ---
NVIDIA_ENABLED=true
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- Scan Type Verification ---
STRICT_SCAN_TYPE_VALIDATION=true
SCAN_TYPE_MIN_CONFIDENCE=0.85
